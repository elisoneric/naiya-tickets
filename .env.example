# Backend API endpoints (change if deploying to a different path)
VITE_API_URL=/backend/api.php
VITE_MAIL_API_URL=/backend/mail_handler.php
VITE_BACKUP_API_URL=/backend/backup_handler.php

# DeepSeek / Indunix AI Configuration
VITE_DEEPSEEK_API_KEY=sk-your-ai-api-key-here
VITE_DEEPSEEK_MODEL=deepseek-flash
VITE_DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# VPN external API key
VITE_VPN_API_KEY=your-vpn-api-key-here

# Shared secret for the mail bridge (set same value in cPanel env as MAIL_INTERNAL_TOKEN)
VITE_MAIL_INTERNAL_TOKEN=your-mail-internal-token-here
